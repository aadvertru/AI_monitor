# Local API defaults
JWT_SECRET=dev-secret-change-me
AUTO_CREATE_SCHEMA=1
DATABASE_URL=sqlite:///./ai_monitor.db

# Real-provider pilot safety defaults
REAL_PROVIDER_ENABLED=false
PROVIDER_MODE=mock
REAL_PROVIDER_MAX_PROVIDERS=1
REAL_PROVIDER_MAX_QUERIES=5
REAL_PROVIDER_MAX_RUNS_PER_QUERY=1
REAL_PROVIDER_MAX_TOTAL_RUNS=5

# OpenAI provider config for local pilot runs.
# Never commit a real API key.
OPENAI_API_KEY=
OPENAI_L1_MODEL=gpt-4.1-mini
OPENAI_L2_MODEL=gpt-4.1-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200

# Seed query generation for real/local working data.
# Use mock only for tests or offline UI development.
SEED_QUERY_GENERATION_ENABLED=true
SEED_QUERY_GENERATION_PROVIDER=openai
SEED_QUERY_GENERATION_MODEL=gpt-4.1-mini
SEED_QUERY_GENERATION_TIMEOUT_SECONDS=30

# OpenRouter gateway provider config for local pilot runs.
# Never commit a real API key.
OPENROUTER_API_KEY=
OPENROUTER_L1_MODEL=
OPENROUTER_L2_MODEL=
OPENROUTER_ALLOWED_MODELS=
OPENROUTER_REQUEST_TIMEOUT_SECONDS=30
OPENROUTER_MAX_OUTPUT_TOKENS=1200
OPENROUTER_WEB_SEARCH_ENABLED=false
OPENROUTER_WEB_SEARCH_TOOL=openrouter:web_search
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AI Brand Visibility Monitor

# Anthropic provider config for local Claude L1 pilot runs.
# Never commit a real API key.
ANTHROPIC_API_KEY=
ANTHROPIC_L1_MODEL=claude-3-5-haiku-latest
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_OUTPUT_TOKENS=1200

# Future Claude L2 config only; not used until L2 is implemented.
ANTHROPIC_L2_MODEL=
ANTHROPIC_WEB_SEARCH_TOOL_VERSION=
ANTHROPIC_WEB_SEARCH_MAX_USES=
