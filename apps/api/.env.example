# Local API defaults
JWT_SECRET=dev-secret-change-me
AUTO_CREATE_SCHEMA=1
DATABASE_URL=sqlite:///./ai_monitor.db

# Real-provider pilot safety defaults
REAL_PROVIDER_ENABLED=false
PROVIDER_MODE=mock
REAL_PROVIDER_MAX_PROVIDERS=1
REAL_PROVIDER_MAX_QUERIES=5
REAL_PROVIDER_MAX_RUNS_PER_QUERY=1
REAL_PROVIDER_MAX_TOTAL_RUNS=5

# OpenAI provider config for local pilot runs.
# Never commit a real API key.
OPENAI_API_KEY=
OPENAI_L1_MODEL=gpt-4.1-mini
OPENAI_L2_MODEL=gpt-4.1-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200
